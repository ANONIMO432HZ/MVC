# Set default behavior to normalize all text files to LF
* text=auto eol=lf

# Explicit text files
*.php text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.html text eol=lf
*.htaccess text eol=lf
*.sh text eol=lf
*.sql text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows scripts (if any)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
